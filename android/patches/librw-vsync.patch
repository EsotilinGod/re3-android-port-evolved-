+	// re3 Android: intervalo de vsync configurable (1 = cada refresco, 2 = uno
+	// de cada dos, ej. 60 FPS en pantalla de 120 Hz) y solo se cambia cuando
+	// hace falta: llamar eglSwapInterval en cada cuadro causa tirones en
+	// algunos drivers.
+	{
+		extern int gLibrwSwapInterval;
+		static int lastInterval = -1;
+		int interval = (flags & Raster::FLIPWAITVSYNCH) ? (gLibrwSwapInterval > 0 ? gLibrwSwapInterval : 1) : 0;
+		if(interval != lastInterval){
+			if(SDL_GL_SetSwapInterval(interval) != 0 && interval > 1)
+				SDL_GL_SetSwapInterval(1);
+			lastInterval = interval;
+		}
+	}
